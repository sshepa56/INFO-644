   "source": [
    "\n",
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "\n",
    "# Load CSV\n",
    "df = pd.read_csv(\"CommunityDistrictSingleYearCounts2023.csv\")\n",
    "\n",
    "# Age group columns\n",
    "age_columns = [\n",
    "    \"Age<=28days\", \"Age 1-12months\", \"Age 1-4\",\n",
    "    \"Age 5-9\", \"Age 10-14\", \"Age 15-19\",\n",
    "    \"Age 20-24\", \"Age 25-29\", \"Age 30-34\",\n",
    "    \"Age 35-39\", \"Age 40-44\", \"Age 45-49\",\n",
    "    \"Age 50-54\", \"Age 55-59\", \"Age 60-64\",\n",
    "    \"Age 65-69\", \"Age 70-74\", \"Age 75-79\",\n",
    "    \"Age 80-84\", \"Age 85+\", \"Age Unkown\"\n",
    "]\n",
    "\n",
    "# Convert age columns to numeric\n",
    "for col in age_columns:\n",
    "    df[col] = pd.to_numeric(\n",
    "        df[col].astype(str).str.replace(\",\", \"\"),\n",
    "        errors=\"coerce\"\n",
    "    ).fillna(0)\n",
    "\n",
    "# Convert community district to string\n",
    "df[\"commntydst\"] = df[\"commntydst\"].astype(str)\n",
    "\n",
    "# Aggregate counts by community district\n",
    "df_grouped = df.groupby(\n",
    "    \"commntydst\", as_index=False\n",
    ")[age_columns].sum()\n",
    "\n",
    "# Convert wide data to long format\n",
    "df_long = df_grouped.melt(\n",
    "    id_vars=\"commntydst\",\n",
    "    value_vars=age_columns,\n",
    "    var_name=\"Age Group\",\n",
    "    value_name=\"Count\"\n",
    ")\n",
    "\n",
    "# Calculate total deaths for each community district\n",
    "df_long[\"District_Total\"] = df_long.groupby(\n",
    "    \"commntydst\"\n",
    ")[\"Count\"].transform(\"sum\")\n",
    "\n",
    "# Calculate percentage of deaths in each age group\n",
    "df_long[\"Percentage\"] = (\n",
    "    df_long[\"Count\"] / df_long[\"District_Total\"] * 100\n",
    ").fillna(0)\n",
    "\n",
    "# Create reversed Turbo color gradient\n",
    "# Youngest = red, oldest = purple\n",
    "known_age_columns = [\n",
    "    col for col in age_columns if col != \"Age Unkown\"\n",
    "]\n",
    "\n",
    "age_colors = px.colors.sample_colorscale(\n",
    "    \"Turbo\",\n",
    "    [\n",
    "        0.95 - i * 0.95 / (len(known_age_columns) - 1)\n",
    "        for i in range(len(known_age_columns))\n",
    "    ]\n",
    ")\n",
    "\n",
    "# Map each age group to its color\n",
    "age_color_map = dict(zip(known_age_columns, age_colors))\n",
    "\n",
    "# Assign gray to unknown age\n",
    "age_color_map[\"Age Unkown\"] = \"#9E9E9E\"\n",
    "\n",
    "# Create horizontal stacked bar chart\n",
    "fig = px.bar(\n",
    "    df_long,\n",
    "    x=\"Count\",\n",
    "    y=\"commntydst\",\n",
    "    color=\"Age Group\",\n",
    "    orientation=\"h\",\n",
    "    barmode=\"stack\",\n",
    "    title=\"2023 Death Count Age Distribution by NYC Community District\",\n",
    "    labels={\n",
    "        \"Count\": \"Death Count\",\n",
    "        \"commntydst\": \"Community District\"\n",
    "    },\n",
    "    category_orders={\n",
    "        \"Age Group\": age_columns,\n",
    "        \"commntydst\": sorted(\n",
    "            df_grouped[\"commntydst\"].unique()\n",
    "        )\n",
    "    },\n",
    "    color_discrete_map=age_color_map,\n",
    "    custom_data=[\"Percentage\", \"District_Total\"],\n",
    "    height=1600\n",
    ")\n",
    "\n",
    "# Customize hover information\n",
    "fig.update_traces(\n",
    "    hovertemplate=(\n",
    "        \"<b>Community District:</b> %{y}<br>\"\n",
    "        \"<b>Age Group:</b> %{fullData.name}<br>\"\n",
    "        \"<b>Death Count:</b> %{x:,.0f}<br>\"\n",
    "        \"<b>Percentage of District Deaths:</b> \"\n",
    "        \"%{customdata[0]:.2f}%<br>\"\n",
    "        \"<b>Total District Deaths:</b> \"\n",
    "        \"%{customdata[1]:,.0f}\"\n",
    "        \"<extra></extra>\"\n",
    "    )\n",
    ")\n",
    "\n",
    "# Customize layout\n",
    "fig.update_layout(\n",
    "    xaxis_title=\"Total Death Count\",\n",
    "    yaxis_title=\"Community District\",\n",
    "    legend_title=\"Age Group\",\n",
    "    legend=dict(\n",
    "        orientation=\"h\",\n",
    "        y=-0.12,\n",
    "        x=0.5,\n",
    "        xanchor=\"center\"\n",
    "    ),\n",
    "    bargap=0.15,\n",
    "    template=\"plotly_white\",\n",
    "    hovermode=\"closest\"\n",
    ")\n",
    "\n",
    "# Display community districts as categories\n",
    "fig.update_yaxes(type=\"category\")\n",
    "\n",
    "# Display chart\n",
    "fig.show()\n"
   ]
  },
