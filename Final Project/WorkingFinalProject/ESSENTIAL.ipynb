   "source": [
    "\n",
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "\n",
    "# Load CSV\n",
    "df = pd.read_csv(\"CommunityDistrictSingleYearCounts2023.csv\")\n",
    "\n",
    "# Age group columns\n",
    "age_columns = [\n",
    "    \"Age<=28days\", \"Age 1-12months\", \"Age 1-4\",\n",
    "    \"Age 5-9\", \"Age 10-14\", \"Age 15-19\",\n",
    "    \"Age 20-24\", \"Age 25-29\", \"Age 30-34\",\n",
    "    \"Age 35-39\", \"Age 40-44\", \"Age 45-49\",\n",
    "    \"Age 50-54\", \"Age 55-59\", \"Age 60-64\",\n",
    "    \"Age 65-69\", \"Age 70-74\", \"Age 75-79\",\n",
    "    \"Age 80-84\", \"Age 85+\", \"Age Unkown\"\n",
    "]\n",
    "\n",
    "# Convert age columns to numeric\n",
    "for col in age_columns:\n",
    "    df[col] = pd.to_numeric(\n",
    "        df[col].astype(str).str.replace(\",\", \"\"),\n",
    "        errors=\"coerce\"\n",
    "    ).fillna(0)\n",
    "\n",
    "# Convert community district to string\n",
    "df[\"commntydst\"] = df[\"commntydst\"].astype(str)\n",
    "\n",
    "# Aggregate counts by community district\n",
    "df_grouped = df.groupby(\n",
    "    \"commntydst\", as_index=False\n",
    ")[age_columns].sum()\n",
    "\n",
    "# Convert wide data to long format\n",
    "df_long = df_grouped.melt(\n",
    "    id_vars=\"commntydst\",\n",
    "    value_vars=age_columns,\n",
    "    var_name=\"Age Group\",\n",
    "    value_name=\"Count\"\n",
    ")\n",
    "\n",
    "# Create horizontal stacked bar chart\n",
    "import numpy as np\n",
    "from matplotlib.colors import LinearSegmentedColormap, to_hex\n",
    "\n",
    "# White-to-dark-blue gradient\n",
    "blue_gradient = LinearSegmentedColormap.from_list(\n",
    "    \"age_blue\",\n",
    "    [\n",
    "        \"#FFFFFF\",\n",
    "        \"#DBEAFE\",\n",
    "        \"#93C5FD\",\n",
    "        \"#3B82F6\",\n",
    "        \"#1D4ED8\",\n",
    "        \"#172554\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "# Assign progressively darker colors to age groups\n",
    "age_colors = {\n",
    "    age: to_hex(blue_gradient(i / (len(age_columns) - 1)))\n",
    "    for i, age in enumerate(age_columns)\n",
    "}\n",
    "\n",
    "# Create horizontal stacked bar chart\n",
    "fig = px.bar(\n",
    "    df_long,\n",
    "    x=\"Count\",\n",
    "    y=\"commntydst\",\n",
    "    color=\"Age Group\",\n",
    "    color_discrete_map=age_colors,\n",
    "    orientation=\"h\",\n",
    "    barmode=\"stack\",\n",
    "    title=\"2023 Age Distribution by NYC Community District\",\n",
    "    labels={\n",
    "        \"Count\": \"Death Count\",\n",
    "        \"commntydst\": \"Community District\"\n",
    "    },\n",
    "    category_orders={\n",
    "        \"Age Group\": age_columns,\n",
    "        \"commntydst\": sorted(df_grouped[\"commntydst\"].unique())\n",
    "    },\n",
    "    height=1600\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    xaxis_title=\"Total Deaths\",\n",
    "    yaxis_title=\"Community District\",\n",
    "    legend_title=\"Age Group\",\n",
    "    legend=dict(\n",
    "        orientation=\"h\",\n",
    "        y=-0.12,\n",
    "        x=0.5,\n",
    "        xanchor=\"center\"\n",
    "    ),\n",
    "    bargap=0.15,\n",
    "    template=\"plotly_white\"\n",
    ")\n",
    "\n",
    "# Add subtle borders so white segments remain visible\n",
    "fig.update_traces(\n",
    "    marker_line_color=\"#CBD5E1\",\n",
    "    marker_line_width=0.3\n",
    ")\n",
    "\n",
    "fig.update_yaxes(type=\"category\")\n",
    "\n",
    "fig.show()\n",
    "\n",
    "# Customize layout\n",
    "fig.update_layout(\n",
    "    xaxis_title=\"Total Count\",\n",
    "    yaxis_title=\"Community District\",\n",
    "    legend_title=\"Age Group\",\n",
    "    legend=dict(\n",
    "        orientation=\"h\",\n",
    "        y=-0.12,\n",
    "        x=0.5,\n",
    "        xanchor=\"center\"\n",
    "    ),\n",
    "    bargap=0.15,\n",
    "    template=\"plotly_white\"\n",
    ")\n",
    "\n",
    "fig.update_yaxes(type=\"category\")\n",
    "\n",
    "fig.show()\n"
   ]
